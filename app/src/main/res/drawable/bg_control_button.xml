<?xml version="1.0" encoding="utf-8"?>
<!-- Duidelijke focusindicatie is verplicht voor D-pad navigatie op Android TV. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/family7_red"/>
            <stroke android:width="2dp" android:color="#FFFFFF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/family7_red_light"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/control_idle"/>
        </shape>
    </item>
</selector>
