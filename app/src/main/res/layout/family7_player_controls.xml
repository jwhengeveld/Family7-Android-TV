<?xml version="1.0" encoding="utf-8"?>
<!--
  Bedieningslayout voor de Media3 PlayerView, op maat voor een 10-voet UI.
  Gebruikt de officiele exo_* id's, zodat PlayerControlView alle gedrag
  (afspelen/pauzeren, spoelen, tijdbalk, automatisch verbergen, mediatoetsen)
  zelf blijft afhandelen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"/>

    <!-- Kop: terugknop, titel en merk -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/tv_safe_margin_horizontal"
        android:paddingEnd="@dimen/tv_safe_margin_horizontal"
        android:paddingTop="@dimen/tv_safe_margin_vertical"
        android:paddingBottom="@dimen/tv_safe_margin_vertical">

        <ImageButton
            android:id="@+id/family7_back"
            android:layout_width="@dimen/tv_back_button"
            android:layout_height="@dimen/tv_back_button"
            android:background="@drawable/bg_control_button"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:focusable="true"
            android:contentDescription="@string/player_back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/family7_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/family7_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/family7_mark"
            android:contentDescription="@string/app_name"/>
    </LinearLayout>

    <!-- Voet: tijd, tijdbalk en transportknoppen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_safe_margin_horizontal"
        android:paddingEnd="@dimen/tv_safe_margin_horizontal"
        android:paddingBottom="@dimen/tv_safe_margin_vertical">

        <LinearLayout
            android:id="@id/exo_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            app:bar_height="6dp"
            app:touch_target_height="32dp"
            app:scrubber_enabled_size="20dp"
            app:scrubber_dragged_size="26dp"
            app:played_color="@color/family7_red"
            app:scrubber_color="#FFFFFF"
            app:buffered_color="#66FFFFFF"
            app:unplayed_color="#33FFFFFF"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@id/exo_rew"
                android:layout_width="@dimen/tv_control_button"
                android:layout_height="@dimen/tv_control_button"
                android:background="@drawable/bg_control_button"
                android:padding="@dimen/tv_control_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/exo_icon_rewind"
                android:focusable="true"
                android:contentDescription="@string/exo_controls_rewind_description"/>

            <ImageButton
                android:id="@id/exo_play_pause"
                android:layout_width="@dimen/tv_control_button_large"
                android:layout_height="@dimen/tv_control_button_large"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_control_button"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:focusable="true"
                android:contentDescription="@string/exo_controls_play_description"/>

            <ImageButton
                android:id="@id/exo_ffwd"
                android:layout_width="@dimen/tv_control_button"
                android:layout_height="@dimen/tv_control_button"
                android:background="@drawable/bg_control_button"
                android:padding="@dimen/tv_control_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/exo_icon_fastforward"
                android:focusable="true"
                android:contentDescription="@string/exo_controls_fastforward_description"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
